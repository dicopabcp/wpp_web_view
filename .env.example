# Copia este archivo a .env.local y completa los valores.

# true = no llama a Olivia; usa respuestas simuladas y los enlaces /s/demo-* (solo desarrollo local)
MOCK_OLIVIA=true

# URL base de la API de Olivia (olivia-bxt-core), sin barra final. Ej: https://servidor-olivia/ApiOliviaBxt
OLIVIA_BASE_URL=

# Debe ser igual a WppFormularios:WebApiKey en el appsettings de Olivia
OLIVIA_WEB_KEY=

# Número de WhatsApp del bot (solo dígitos, con código de país) para el botón "Volver a WhatsApp". Ej: 59175883934
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Filtro por navegador (apagado por defecto). true = solo permite user-agents que coincidan con el patrón.
# Cuidado: en iPhone el navegador de WhatsApp se identifica como Safari y en Android a veces abre Chrome.
RESTRINGIR_NAVEGADOR=false
PATRON_NAVEGADOR_PERMITIDO=WhatsApp
